# 複製成 .streamlit/secrets.toml（本機使用，不要上傳到 GitHub），
# 或把以下內容貼到 Streamlit Community Cloud 的 App settings → Secrets。
GEMINI_API_KEY = "貼上你的 Gemini 金鑰"

# 選填：改用 Claude（有 ANTHROPIC_API_KEY 時自動使用 Claude，Gemini 金鑰可以保留當備用）
# ANTHROPIC_API_KEY = "sk-ant-..."
# CLAUDE_MODEL = "claude-opus-5-5"      # 也可以用 claude-sonnet-5-5（較快較省）、claude-haiku-5-5（最快最省）
# CLAUDE_EFFORT = "medium"              # low 最快、medium 預設、high 最仔細；問答類固定用 low
# AI_PROVIDER = "gemini"                # 有 Claude 金鑰但想暫時改回 Gemini 時設定

# 線上資料庫（Supabase）：填了就把資料存在線上，沒填就存在這台電腦的 data 資料夾（見 docs/deploy.md）
# SUPABASE_URL = "https://你的專案.supabase.co"
# SUPABASE_KEY = "service_role 或 secret 金鑰（只能放在這裡，不要公開）"

# 建議填：設定後，建立新社團帳號時必須輸入這組邀請碼
# SIGNUP_CODE = "自訂一組邀請碼"

# 選填：AI 思考程度 minimal／low／medium／high（越低越快，預設 low；default 為模型預設、通常最慢）
# GEMINI_THINKING = "low"

# 選填
# GEMINI_MODEL = "gemini-flash-latest"
# MONTHLY_AI_LIMIT = "200"              # 每個社團每月可用的 AI 次數（全體幹部共用），避免儲值額度用光
# MAX_RUNS_PER_SESSION = "20"
# CLUB_AGENT_DATA_DIR = "data"
